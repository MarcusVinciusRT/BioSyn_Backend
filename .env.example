# ---------------------------------------------------------------------------
# BioSyn API — copie para .env e preencha. O .env NUNCA vai para o git.
# ---------------------------------------------------------------------------

AMBIENTE=dev
LOG_LEVEL=INFO

# --- Oracle Autonomous Database -------------------------------------------
# O mesmo usuario atende OLTP (tabelas do DDL), leitura de GOLD e Select AI.
DB_USER=APP_BACKEND
DB_PASSWORD=troque-me
# mTLS com wallet: nome do servico dentro do tnsnames.ora (ex: dbdatasus_medium)
# TLS sem wallet: cole a connection string TLS do Console OCI e deixe WALLET_DIR vazio
DB_DSN=dbdatasus_medium
WALLET_DIR=./wallet
WALLET_PASSWORD=
DB_POOL_MIN=1
DB_POOL_MAX=8

# --- JWT -------------------------------------------------------------------
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-me
JWT_ALGORITMO=HS256
JWT_EXPIRA_SEGUNDOS=1800

# --- Select AI (chat) ------------------------------------------------------
AI_PROFILE_NAME=APP_PROFILE
AI_TIMEOUT_SEGUNDOS=60

# --- Canal de alertas (secao 5) --------------------------------------------
# console = apenas registra no log, nada e enviado. Troque para smtp quando
#           tiver as credenciais do provedor de e-mail.
ALERTA_CANAL=console
ALERTA_TAMANHO_LOTE=50

# Qualquer provedor SMTP serve -- nao ha SDK proprietario no codigo.
#
# CAMINHO MAIS RAPIDO: sua propria conta Gmail.
#   SMTP_HOST=smtp.gmail.com  SMTP_PORTA=587  SMTP_SEGURANCA=starttls
#   SMTP_SENHA precisa ser uma SENHA DE APP, nao a senha do login -- o Google
#   desativou SMTP com a senha da conta. Gere em: myaccount.google.com ->
#   Seguranca -> Senhas de app (exige verificacao em duas etapas ligada).
#   SMTP_REMETENTE tem que ser IGUAL ao SMTP_USUARIO: o Gmail nao envia como
#   outro endereco. Limite de ~500 e-mails/dia.
#
# Outros provedores, se precisar de volume ou de remetente institucional:
#   Brevo   host=smtp-relay.brevo.com  porta=587  (~300 e-mails/dia gratis)
#   Resend  host=smtp.resend.com       porta=587  (usuario=resend, senha=API key)
#   SES     host=email-smtp.<regiao>.amazonaws.com  porta=587
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=alertas@saude.gov.br
SMTP_REMETENTE_NOME=BioSyn
SMTP_SEGURANCA=starttls

# --- Relatorios ------------------------------------------------------------
# views    = consulta as views nomeadas em METRICAS.nome_view
# fallback = agrega direto de GOLD.INTERNACOES enquanto as views nao existem
LAKEHOUSE_MODO=fallback
LAKEHOUSE_TABELA_FALLBACK=GOLD.INTERNACOES

# --- CORS ------------------------------------------------------------------
CORS_ORIGENS=http://localhost:5173,http://localhost:3000
